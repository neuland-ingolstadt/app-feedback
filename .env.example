LISTEN_ADDR=:8080
DATABASE_URL=file:feedback.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Required in production. For local: ALLOW_INSECURE_DEV_SECRET=1
CHALLENGE_SECRET=
ALLOW_INSECURE_DEV_SECRET=1

# Optional shared key the app sends as X-Feedback-Key
WRITE_KEY=

# Bearer token for GET /v1/admin/export
ADMIN_TOKEN=

# Comma-separated campaign allowlist (empty = any well-formed campaign id)
ALLOWED_CAMPAIGNS=feedback-campaign-2026-10-29_18-55

POW_DIFFICULTY=18
CHALLENGE_TTL=2m
IP_RATE_LIMIT=0.2
IP_RATE_BURST=5
ID_RATE_LIMIT=0.1
ID_RATE_BURST=3
MAX_UPSERTS_PER_ID=8
TRUSTED_PROXY_COUNT=1
SHADOW_BAN_THRESHOLD=0.65
REJECT_THRESHOLD=0.9
